      {
        "selector": "JSXOpeningElement[name.name='BenefitCallout'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|image|align|key|ref|className|style|children)$/]",
        "message": "<BenefitCallout> doesn't accept that prop. Declared props: title, body, image, align."
